    {
      "parameters": {
        "promptType": "define",
        "text": "=Categorize this YouTube comment into exactly ONE of these categories: Spam, Toxic, Question, Positive, Negative, Neutral.\n\nComment: {{ $json.text }}\nAuthor: {{ $json.author }}\n\nRespond with ONLY the category name, nothing else.",
        "options": {
          "systemMessage": "You are a YouTube comment moderator assistant. Your job is to classify comments accurately into one category only. Do not explain your reasoning, just output the single category word.\n\nCategories:\n- Spam: promotional links, unrelated content, bot-like repetitive text\n- Toxic: hate speech, harassment, offensive language\n- Question: genuine questions from viewers\n- Positive: praise, compliments, positive emojis/reactions\n- Negative: complaints, criticism (non-toxic)\n- Neutral: general comments that don't fit other categories"
        }
      },
